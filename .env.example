# Copie este arquivo para ".env.local" e preencha com os dados do SEU projeto no Supabase
# (Project Settings > API). O arquivo .env.local não vai para o GitHub.
#
# Sem estas duas variáveis o sistema roda em MODO LOCAL (começa vazio e guarda os dados só no navegador).
# Depois de alterar, reinicie o "npm run dev".

# Endereço do projeto, ex.: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Chave PÚBLICA do projeto (anon / publishable). Nunca use a chave "service_role" ou "secret" aqui.
VITE_SUPABASE_ANON_KEY=
